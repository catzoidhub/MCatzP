{
  "name": "mcatzp",
  "version": "1.0.0",
  "description": "MCatzP \u2014 the MCP with the cats inside: one MCP server for every Catzoid app (DevCatz, DBCatz, DialCatz, DoCatz).",
  "license": "Apache-2.0",
  "homepage": "https://catzoid.com/mcatzp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catzoidhub/MCatzP.git"
  },
  "type": "module",
  "bin": {
    "mcatzp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/bin",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "bun build src/index.ts --compile --outfile dist/bin/mcatzp"
  },
  "dependencies": {
    "@catzoid/mcatzp-protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0"
  }
}
